asterisk = '*'

while True:
	try: 
		limit =  int(input("Kindly give a range for your multiplication table: "))
		print("\t")
		print(asterisk*(limit//2)*8, "MULTIPLICATION TABLE", asterisk*(limit//2)*8, end="")
		print()

		for x in range(1, limit+1):
			for y in range(1, limit+1):
				print(x*y, end="\t")
			print()
		
		retry = input("Would you like to repeat (y/n): ")
		if retry.casefold() == "n":
			break

	except ValueError:
		print("Invalid Input")
